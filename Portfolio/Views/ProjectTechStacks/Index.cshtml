@model List<Project>
@{
    ViewData["Title"] = "Proje Teknolojileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<table class="table table-hover table-bordered" >
    <tr>
        <th>#</th> 
        <th>Proje Adı</th>
        <th>Kullanılan Teknolojiler</th>
    </tr>
    @foreach (var item in Model)
    {
    count++;
        <tr>
            <td>@count</td>
            <td>@item.Name</td>
            <td>@string.Join(", ", item.ProjectTechStacks.Select(x => x.TechStack.Name))</td>

        </tr>
}
</table>

<a href="/ProjectTechStacks/Create" class="btn btn-outline-dark"> Yeni Giriş</a>
