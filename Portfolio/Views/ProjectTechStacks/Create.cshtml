@model ProjectTechStack
@{
    ViewData["Title"] = "Proje Teknolojileri Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">  
    <labe>Proje</labe>
    <select class="form-control" asp-for="ProjectId" asp-items="@ViewBag.projects" required>
        <option selected disabale>-- Proje Seçiniz --</option>
    </select>

    <label>Teknoloji</label>
    <select class="form-control" asp-for="TechStackId" asp-items="@ViewBag.techStacks">
        <option selected disabale>-- Teknoloji Seçiniz --</option>
    </select>
    <br />

    <button class="btn btn-outline-dark"> Kaydet </button>

</form>

