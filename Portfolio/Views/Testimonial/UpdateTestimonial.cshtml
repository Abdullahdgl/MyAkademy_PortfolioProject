@model Testimonial

@{
    ViewData["Title"] = "Müşteri Yorumu Düzenle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Yıldız</label>
        <input type="text" class="form-input" asp-for="Rating" required>
    </div>

    <div class="form-group">
        <label class="form-label">Yorum</label>
        <textarea asp-for="Comment" class="form-input" rows="5" required></textarea>
    </div>

    <div class="form-group">
        <label class="form-label">Adı</label>
        <input type="text" asp-for="FirstName" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Soyadı</label>
        <input type="text" asp-for="LastName" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Baş Harfler</label>
        <input type="text" asp-for="Initials" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Başlık</label>
        <input type="text" asp-for="Title" class="form-input" required />
    </div>


    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Güncelle
        </button>
    </div>
</form>