@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<style>
    .stat-card {
        border: none !important;
        border-radius: 16px !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease !important;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.15) !important;
        }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

        .icon-box i {
            font-size: 2rem !important;
            color: #fff !important;
        }

    .stat-title {
        color: rgba(255, 255, 255, 0.85) !important;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px !important;
    }

    .stat-value {
        color: #fff !important;
        font-weight: 700 !important;
        font-size: 1.8rem !important;
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #ff9900 0%, #ff5500 100%) !important;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #28a745 0%, #117a8b 100%) !important;
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #ff3547 0%, #c3002f 100%) !important;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #4285f4 0%, #1266f1 100%) !important;
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title mb-4" style="font-weight: 700; color: #333;">İstatistikler</h4>
        <div class="row">

            <!-- Yetenek Sayısı -->
            <div class="col-md-3">
                <div class="card card-stats stat-card bg-gradient-warning shadow">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-5">
                                <div class="icon-box">
                                    <i class="la la-certificate"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="stat-title">Yetenek Sayısı</p>
                                    <h4 class="stat-value">@ViewBag.v1</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toplam Mesaj -->
            <div class="col-md-3">
                <div class="card card-stats stat-card bg-gradient-success shadow">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-5">
                                <div class="icon-box">
                                    <i class="la la-envelope"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="stat-title">Toplam Mesaj</p>
                                    <h4 class="stat-value">@ViewBag.v2</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Okunmayanlar -->
            <div class="col-md-3">
                <div class="card card-stats stat-card bg-gradient-danger shadow">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-5">
                                <div class="icon-box">
                                    <i class="la la-envelope-o"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="stat-title">Okunmayanlar</p>
                                    <h4 class="stat-value">@ViewBag.v3</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Okunanlar -->
            <div class="col-md-3">
                <div class="card card-stats stat-card bg-gradient-primary shadow">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-5">
                                <div class="icon-box">
                                    <i class="la la-check-circle-o"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="stat-title">Okunanlar</p>
                                    <h4 class="stat-value">@ViewBag.v4</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <br />
