@model LoginViewModel
@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>

	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

	<title>Yönetim Paneli</title>

	<style>

		body {
			background: #0d0f11;
			font-family: Inter,Segoe UI,sans-serif;
			color: white;
		}

		.login-wrapper {
			min-height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
			
		}

		.login-card {
			width: 100%;
			max-width: 420px;
			background: #15181d;
			border: 1px solid #23262d;
			border-radius: 18px;
			padding: 45px;
			box-shadow: 0 20px 45px rgba(0,0,0,.35);
		}

		.logo {
			font-size: 40px;
			font-weight: 800;
			letter-spacing: .5px;
			text-align: center;
			margin-bottom: 45px;
		}

			.logo span {
				color: #9c97ff;
			}

		.form-control {
			background: #1b1e24;
			border: 1px solid #2a2f37;
			color: white;
			height: 54px;
		}

			.form-control:focus {
				background: #1b1e24;
				color: white;
				border-color: #9c97ff;
				box-shadow: 0 0 0 .2rem rgba(156,151,255,.15);
			}

			.form-control::placeholder {
				color: #8b9097;
			}

		.btn-login {
			background: #9c97ff;
			border: none;
			color: #111;
			font-weight: 700;
			height: 54px;
			transition: .3s;
		}

			.btn-login:hover {
				background: #b2adff;
			}
	</style>

</head>
<body>

	<div class="container">

		<div class="login-wrapper">

			<div class="login-card">

				<div class="logo">
					Admin <span>Login</span>
				</div>

				

				<form method="post">

					<div class="mb-3">

						<input type="text" asp-for="UserName" class="form-control" />
						<span class="text-danger" asp-validation-for="UserName"></span>

					</div>

					<div class="mb-4">

						<input type="password" asp-for="Password" class="form-control" />
						<span class="text-danger" asp-validation-for="Password"></span>

					</div>


					<span class="text-danger">@Html.ValidationSummary(excludePropertyErrors: true)</span>

					<div class="d-grid">

						<button class="btn btn-login">
							Giriş Yap
						</button>

					</div>

				</form>

			</div>

		</div>

	</div>

</body>
</html>




