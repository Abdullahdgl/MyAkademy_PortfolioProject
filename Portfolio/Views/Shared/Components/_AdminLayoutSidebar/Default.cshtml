@*
    Admin Layout SideBar
   
*@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<aside class="w-sidebar-width h-screen fixed left-0 top-0 bg-surface-lowest border-r border-outline-variant flex flex-col py-lg z-50">

    <div class="px-md mb-xl flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-md shadow-primary/30">
            <span class="material-symbols-outlined text-[24px]">space_dashboard</span>
        </div>
        <div class="flex flex-col">
            <h2 class="text-h3 font-bold text-on-surface leading-tight">Portfolyo</h2>
            <p class="text-on-surface-variant text-label-sm">Yönetim Paneli</p>
        </div>
    </div>



    @* <div class="px-md mb-xl">
        <h2 class="font-h2 text-h2 font-bold text-primary">Portfolyo Admin Paneli</h2>
        <p class="text-on-surface-variant font-label-sm mt-xs">Yöneim sayfası </p>
    </div> *@


    <nav class="flex-1 space-y-1">
        <!-- Dashboard (Inactive) -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="#">
            <span class="material-symbols-outlined">dashboard</span>
            <span class="font-label-md text-label-md">Dashboard</span>
        </a>





        <!-- Experiences -->
        <a href="/Experience/Index"
           class="relative flex items-center gap-md px-md py-sm transition-colors duration-200 cursor-pointer active:opacity-80 @(currentController == "Experience" ? "text-primary bg-surface-container-low border-l-4 border-primary" : "text-on-surface-variant hover:bg-surface-container-highest border-l-4 border-transparent")">
            <span class="material-symbols-outlined" style="@(currentController == "Experience" ? "font-variation-settings: 'FILL' 1;" : "")">work_history</span>
            <span class="font-label-md text-label-md @(currentController == "Experience" ? "font-semibold" : "")">Deneyimler</span>
        </a>

        <!-- Education -->
        <a href="/Education/Index"
           class="relative flex items-center gap-md px-md py-sm transition-colors duration-200 cursor-pointer active:opacity-80 @(currentController == "Education" ? "text-primary bg-surface-container-low border-l-4 border-primary" : "text-on-surface-variant hover:bg-surface-container-highest border-l-4 border-transparent")">
            <span class="material-symbols-outlined" style="@(currentController == "Education" ? "font-variation-settings: 'FILL' 1;" : "")">school</span>
            <span class="font-label-md text-label-md @(currentController == "Education" ? "font-semibold" : "")">Eğitimler</span>
        </a>









        <!-- Projects (Active) -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Project/Index">
            <span class="material-symbols-outlined">dashboard</span>
            <span class="font-label-md text-label-md">Projelerim</span>
        </a>
        <!-- Hakkımda -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80"
        href="/About/Index">
            <span class="material-symbols-outlined">category</span>
            <span class="font-label-md text-label-md">Hakkımızda</span>
        </a>
        <!-- Messages -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/UserMessage/Index">
            <span class="material-symbols-outlined">mail</span>
            <span class="font-label-md text-label-md">Gelen Mesajlar</span>
        </a>
        <!-- Settings -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="#">
            <span class="material-symbols-outlined">settings</span>
            <span class="font-label-md text-label-md">Yeteneklerim</span>
        </a>

       


        <a class="flex items-center gap-md px-md py-2 rounded-xl text-error hover:bg-error-container/30 transition-all duration-200 group active:scale-95"
           href="/Auth/Logout">
            <span class="material-symbols-outlined text-[22px] transition-transform group-hover:translate-x-1">logout</span>
            <span class="text-body-md font-semibold">Çıkış Yap</span>
        </a>

   

        

    </nav>
    <div class="mt-auto px-md flex items-center gap-md pt-lg border-t border-outline-variant">
        <img class="w-10 h-10 rounded-full object-cover" data-alt="A professional headshot of a senior project manager with a friendly expression, wearing a navy blue blazer against a neutral office background. The lighting is soft and professional, emphasizing a modern corporate aesthetic with high-quality, high-key values." src="https://media.licdn.com/dms/image/v2/C4D03AQE1XAeg6i7dvQ/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1652968380790?e=2147483647&v=beta&t=TwLLUIQ_XFoClJu7Nis5706uKlBAVNnyj1ANMCYAae4" />
        <div>
            <p class="font-label-md text-label-md font-bold text-on-surface">@ViewBag.fullName</p>
            <p class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Admin</p>
        </div>
       

    </div>
</aside>