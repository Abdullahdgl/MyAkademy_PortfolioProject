@model Skill
@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h1>UpdateSkill</h1>

<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Yetenek Adı</label>
        <input type="text" class="form-input" asp-for="Name" required>
    </div>

    <div class="form-group">
        <label class="form-label">
            <input type="checkbox" asp-for="IsActive" /> Durum
        </label>
    </div>


    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>