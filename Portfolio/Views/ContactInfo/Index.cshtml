@model ContactInfo
@{
    ViewData["Title"] = "İletişim Bilgileri.";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" asp-controller="ContactInfo" asp-action="UpdateContactInfo">
    <input type="hidden" asp-for="Id" />
    <header class="mb-10 flex flex-col">
        <div>
            <h2 class="text-display-lg text-on-surface">
                İletişim Bilgileri
            </h2>
            <p class="text-body-lg text-on-surface-variant">
                Ziyaretçilerin size ulaşabileceği bilgileri yönetin.
            </p>
        </div>
        <button type="submit" class="self-end mt-1 inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary text-on-primary rounded-lg whitespace-nowrap hover:shadow-lg transition-all active:scale-95">
            <span class="material-symbols-outlined text-[21px]">save</span>
            <span>Değişiklikleri Kaydet</span>
        </button>
    </header>
    <div class="max-w-5xl mx-auto px-3 py-4 md:px-4 md:py-5 xl:px-6 xl:py-6">
        <div class="w-full space-y-4">
            <div class="w-full rounded-xl border border-outline-variant bg-surface-container-lowest p-4 md:p-6">
                <div class="mb-5 flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-[24px]">info</span>
                    <h3 class="font-h2 text-h2">E-Posta &amp; Konum</h3>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-1">
                    <div class="space-y-2">
                        <label class="block font-label-md text-label-md text-on-surface">E-posta Adresi</label>
                        <input type="email" asp-for="Email" placeholder="E-Posta adresini girin" class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2.5 text-body-lg text-on-surface outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" />
                    </div>
                    <div class="space-y-2 md:col-span-1">
                        <label class="block font-label-md text-label-md text-on-surface">Adres</label>
                        <textarea asp-for="Address" rows="2" placeholder="Adres girin" class="w-full resize-none rounded-lg border border-outline-variant bg-surface px-4 py-2.5 text-body-lg text-on-surface outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20">Maslak, Büyükdere Cd. No:243, 34398 Sarıyer/İstanbul</textarea>
                    </div>
                </div>
            </div>
            <div class="w-full rounded-xl border border-outline-variant bg-surface-container-lowest p-4 md:p-6">
                <div class="mb-5 flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-[24px]">share</span>
                    <h3 class="font-h2 text-h2">Sosyal Medya Hesapları</h3>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div class="space-y-2">
                        <label class="block font-label-md text-label-md text-on-surface">LinkedinURL</label>
                        <div class="relative">
                            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-on-surface-variant">code_blocks</span>
                            <input asp-for="@Model.linkedinUrl" type="url" placeholder="Linkedin adresini girin" class="w-full rounded-lg border border-outline-variant bg-surface py-2.5 pl-10 pr-4 text-body-lg text-on-surface outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" />
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="block font-label-md text-label-md text-on-surface">GitHubURL</label>
                        <div class="relative">
                            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-on-surface-variant">code_blocks</span>
                            <input asp-for="@Model.GithubUrl" type="url" placeholder="GitHub adresini girin" class="w-full rounded-lg border border-outline-variant bg-surface py-2.5 pl-10 pr-4 text-body-lg text-on-surface outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>