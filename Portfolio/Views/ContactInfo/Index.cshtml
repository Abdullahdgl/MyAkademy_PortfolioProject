@model ContactInfo
@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    /* Form Ana Konfigürasyonu */
    .custom-form {
        max-width: 550px;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(229, 231, 235, 0.8);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        margin-top: 1rem;
    }

        /* Her Bir Input Grubu */
        .custom-form .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            text-align: left;
        }

        /* Label Alanı */
        .custom-form .form-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }

            .custom-form .form-label i {
                color: #4f46e5;
                font-size: 0.95rem;
            }

        /* Input Kutuları */
        .custom-form .form-input {
            width: 100% !important;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 8px;
            outline: none;
            background-color: #ffffff;
            transition: all 0.2s ease-in-out;
            box-sizing: border-box !important;
        }

            .custom-form .form-input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            }

    /* Success Alert Stili */
    .alert-message.alert-success {
        max-width: 550px;
        padding: 0.85rem 1rem;
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    /* Buton Alanı */
    .custom-form .form-actions {
        margin-top: 1.5rem;
        display: flex;
        justify-content: flex-end;
    }

    .custom-form .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #2563eb;
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .custom-form .btn-primary:hover {
            background-color: #1d4ed8;
        }
</style>

@if (ViewBag.Durum != null)
{
    <div class="alert-message alert-success">@ViewBag.Durum</div>
}

<form method="post" class="glass-card custom-form">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label class="form-label" asp-for="Email">
            <i class="fa-solid fa-envelope"></i> Email Adresi
        </label>
        <input type="email" class="form-input" asp-for="Email" placeholder="ornek@email.com" required>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Address">
            <i class="fa-solid fa-location-dot"></i> Adres
        </label>
        <input type="text" class="form-input" asp-for="Address" placeholder="Şehir, İlçe..." required>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="linkedinUrl">
            <i class="fa-brands fa-linkedin"></i> LinkedIn URL
        </label>
        <input type="url" class="form-input" asp-for="linkedinUrl" placeholder="https://linkedin.com/in/..." required />
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="GithubUrl">
            <i class="fa-brands fa-github"></i> GitHub URL
        </label>
        <input type="url" class="form-input" asp-for="GithubUrl" placeholder="https://github.com/..." required />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>