@model Experience
@{
    ViewData["Title"] = "Deneyim Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h1>Update</h1>


<form method="post">
    <label>Ünvan</label>
    <input type="text" asp-for="Title" class="form-control" required />
    <br />

    <label>Açıklama</label>
    <input type="text" asp-for="Description" class="form-control" required />
    <br />
    <label>Şirket</label>
    <textarea type="text" asp-for="Company" class="form-control" rows="5" required> </textarea>
    <br />
    <div>

        <label class="form-label">Başlama Tarihi</label>
        <input type="text" asp-for="StartYear" class="form-input" required />
    </div>


    <br />
    <div>

        <label class="form-label">Bitirme Tarihi</label>
        <input type="text" asp-for="EndYear" class="form-input" required />
    </div>

   

    <span class="text-danger">@Html.ValidationSummary()</span>

    <button class="btn btn-outline-dark">Güncelle</button>
</form>

