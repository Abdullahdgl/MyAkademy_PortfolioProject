@{
    Layout = null;
}


<!DOCTYPE html>

<html class="light" lang="tr">

 @*  @await Html.PartialAsync("/Views/AdminLayout/HeadPartial.cshtml"); *@

  @await Component.InvokeAsync("_AdminLayoutHead")

<body class="font-body-md text-body-md">
    <!-- SideNavBar -->
    @await Component.InvokeAsync("_AdminLayoutSidebar")

    <!-- TopNavBar -->
    @await Component.InvokeAsync("_AdminTopNavbar")

   
    <!-- Main Content Area -->
    <main class="ml-[260px] pt-16 min-h-screen p-lg">
        <!-- Page Title & Stats -->
       
        <div class="container">
            <br />
            <div class="mb-xl">
                <h1 class="font-h1 text-h1 text-on-surface mb-lg">@ViewData["Title"]</h1>
            </div>
            @RenderBody()
        </div>
    </main>
   
    @await Component.InvokeAsync("_AdminLayoutScript")


</body>
</html>








